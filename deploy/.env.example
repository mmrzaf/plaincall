# Copy to .env and fill in. Run ../scripts/generate-secrets.sh to make the secrets.

# Public addresses. The RTC domain must point straight at this server, not
# through a CDN or proxy, because it carries WebSocket signalling for media.
PLAINCALL_DOMAIN=call.example.com
PLAINCALL_RTC_DOMAIN=rtc.example.com

# The address people reach this server on for media. It is advertised to
# browsers, so it must be the public IP, not a private one.
PLAINCALL_SERVER_PUBLIC_IP=203.0.113.10

# Member keys: label:secret, separated by commas. Anyone with a key can host.
# Remove a person's entry to revoke their access.
PLAINCALL_KEYS=team:replace-with-a-random-key

# Credentials shared by PlainCall and LiveKit. The secret must be 32+ characters.
LIVEKIT_API_KEY=replace-with-a-key-name
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Images. Pin PLAINCALL_IMAGE to a release, such as ghcr.io/mmrzaf/plaincall:1.0.0,
# to control when upgrades happen.
PLAINCALL_IMAGE=ghcr.io/mmrzaf/plaincall:latest
LIVEKIT_VERSION=v1.13.7
